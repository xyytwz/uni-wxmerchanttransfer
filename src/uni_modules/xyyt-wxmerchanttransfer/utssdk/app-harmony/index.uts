/**
 * xyyt-wxmerchanttransfer
 * 微信商家转账用户确认收款（WXOpenBusinessView / requestMerchantTransfer）鸿蒙实现
 *
 * 依赖：@tencent/wechat_open_sdk（见同目录 config.json），要求微信客户端 >= 8.0.11.34
 *
 * Want 分发机制（自动接管）：
 *  插件在模块加载时通过 UTSHarmony.onAppAbilityCreate / onAppAbilityNewWant 自行监听宿主
 *  EntryAbility 生命周期并接管微信回跳的 Want（官方 UTSHarmony 兼容性：uni-app HarmonyOS
 *  UTS 插件 >= 4.31），因此工程无需修改任何原生代码（鸿蒙只有本地打包，不存在云打包）。
 *  宿主仍必须在 module.json5 配齐两项（缺一不可）：
 *   - module.querySchemes 含 "weixin"：管拉起。缺失时 SDK 的 isWXAppInstalled() 里
 *     canOpenLink("weixin://") 抛 BusinessError 17700056 并被吞成 false，误报“未安装微信”。
 *   - module.abilities[].skills[].actions 含 "wxentity.action.open"：管回跳。缺失时调起
 *     仍成功（确认收款页照样打开），但回跳 Want 路由不回宿主，确认结果永远取不到。
 *  两项均编译进 HAP，改后必须重新构建安装，WGT 热更新 / 替换 www 无效。详见 readme.md 2.2。
 *
 * 兼容与兜底路径（均为可选）：
 *  - handleWeChatWant(want)：离线打包等自行维护 EntryAbility 的工程，可继续手工转发 Want。
 *  - setMerchantTransferAppId(appId)：冷启动回跳（App 被回收后从微信返回）时插件尚无 WXApi
 *    实例，宿主在启动早期配置一次 appId 即可让该场景的 Want 也被正常分发。
 *  - 与宿主其他微信能力（oauth 登录等）可共存：各自 handleWant 各自处理认识的 resp 类型。
 *
 * 已验证环境：uni-app（vue3）+ 自定义原生壳工程（DevEco）+ @tencent/wechat_open_sdk 1.0.23 真机通过。
 */
import * as wxopensdk from '@tencent/wechat_open_sdk'
import Want from '@ohos.app.ability.Want'
import AbilityConstant from '@ohos.app.ability.AbilityConstant'
import bundleManager from '@ohos.bundle.bundleManager'
import { BusinessError } from '@ohos.base'
import { common } from '@kit.AbilityKit'
import {
	RequestMerchantTransfer,
	RequestMerchantTransferOptions,
	RequestMerchantTransferGeneralCallbackResult,
	MerchantTransferResult,
	MerchantTransferResultCallback,
	OnMerchantTransferResult,
	OffMerchantTransferResult,
	GetLastMerchantTransferResult,
	ClearMerchantTransferResult
} from '../interface.uts'

const TRANSFER_BUSINESS_TYPE = 'requestMerchantTransfer'
const TAG = 'xyyt-wxmerchanttransfer'
/** SDK 的 isWXAppInstalled() 底层就是对该 link 调 canOpenLink，用于自查失败成因 */
const WEIXIN_SCHEME_LINK = 'weixin://'

/** WXApi 单例（按 appId 缓存创建，避免每次调用重复 createWXAPI） */
let _wxApi: wxopensdk.WXApi | null = null
let _wxApiAppId = ''
/** 一次性结果回调（微信回跳 onResp 时触发并自动注销） */
let _pendingResultCallback: MerchantTransferResultCallback | null = null
/** 最近一次结果缓存（供轮询式读取） */
let _lastResult: MerchantTransferResult | null = null
/** EntryAbility 生命周期钩子是否已安装（防重复注册） */
let _hooksInstalled = false
/** WXApi 尚未就绪时暂存的回跳 Want，待 appId 可用后补投 */
let _pendingWant: Want | null = null

class TransferEventHandler implements wxopensdk.WXApiEventHandler {
	onReq(req: wxopensdk.BaseReq): void {
	}

	onResp(resp: wxopensdk.BaseResp): void {
		if (resp instanceof wxopensdk.OpenBusinessViewResp) {
			const transferResp = resp as wxopensdk.OpenBusinessViewResp
			if (transferResp.businessType === TRANSFER_BUSINESS_TYPE) {
				const extMsg = transferResp.extMsg ?? ''
				console.info(TAG + ' onResp extMsg: ' + extMsg)
				const parsed = parseTransferResult(extMsg)
				_lastResult = parsed
				const cb = _pendingResultCallback
				_pendingResultCallback = null
				if (cb != null) {
					try {
						cb(parsed)
					} catch (e) {
						console.error(TAG + ' result callback error: ' + JSON.stringify(e))
					}
				}
			}
		}
	}
}

const _eventHandler = new TransferEventHandler()

/**
 * 解析微信回传 extMsg（格式 {"result":"success|fail|cancel"}）。
 * 用字符串特征判断避免 UTS/ArkTS 下 JSON.parse 的类型差异，errMsg 透传原始 extMsg。
 */
function parseTransferResult(extMsg: string): MerchantTransferResult {
	let result = 'fail'
	if (extMsg.indexOf('"success"') != -1) {
		result = 'success'
	} else if (extMsg.indexOf('"cancel"') != -1) {
		result = 'cancel'
	}
	const res: MerchantTransferResult = {
		result: result,
		errMsg: extMsg
	}
	return res
}

/**
 * 按需创建 WXApi 单例；appId 传 '' 表示沿用上次创建时的 appId。
 */
function ensureWxApi(appId: string): boolean {
	const id = appId != '' ? appId : _wxApiAppId
	if (id == '') {
		return false
	}
	if (_wxApi == null || (appId != '' && appId != _wxApiAppId)) {
		_wxApi = wxopensdk.WXAPIFactory.createWXAPI(id)
		_wxApiAppId = id
	}
	return _wxApi != null
}

/**
 * 区分「真的没装微信」与「宿主 querySchemes 未配置」。
 * SDK 的 isWXAppInstalled() 实现是 bundleManager.canOpenLink("weixin://") 并 try/catch 后
 * return false，querySchemes 缺 "weixin" 时抛出的 BusinessError（实测 17700056）会被吞掉，
 * 导致配置缺失被误报成环境问题。这里自己再调一次拿回真实成因。
 */
function wechatUnavailableMsg(): string {
	try {
		// 不抛异常仍调起失败 → 确实是微信自身不可用（未安装或版本过低）
		bundleManager.canOpenLink(WEIXIN_SCHEME_LINK)
		return '未安装微信或微信版本过低，无法打开确认收款页面，请安装/升级微信后重试'
	} catch (err) {
		const e = err as BusinessError
		const code = e.code
		console.error(TAG + ' canOpenLink(' + WEIXIN_SCHEME_LINK + ') threw, code=' + code + ', message=' + e.message)
		return '未能拉起微信：宿主 querySchemes 大概率未配置 "weixin"（canOpenLink 报 code=' + code
			+ '，非未安装微信）。请在 entry/src/main/module.json5 的 module 节点补 querySchemes: ["weixin"]，'
			+ '该文件编译进 HAP，必须重新构建并安装（WGT 热更新无效）'
	}
}

/**
 * 日志用：只输出可选字段的键名，不打印取值。
 * query 里的 package 是后端下发的一次性转账单据令牌、openId 是用户标识，
 * 完整打到 hilog 等于把凭据落到设备日志（hdc 可直接拉取），因此仅保留排查所需的结构信息。
 */
function optionalFieldFlags(options: RequestMerchantTransferOptions): string {
	const flags: string[] = []
	if (options.openId != null && options.openId != '') {
		flags.push('openId')
	}
	if (options.subAppId != null && options.subAppId != '') {
		flags.push('subAppId')
	}
	if (options.subMchId != null && options.subMchId != '') {
		flags.push('subMchId')
	}
	return flags.length > 0 ? flags.join(',') : 'none'
}

function notifyResult(options: RequestMerchantTransferOptions, ok: boolean, errMsg: string): void {
	const res: RequestMerchantTransferGeneralCallbackResult = { errMsg: errMsg }
	if (ok) {
		try {
			options.success?.(res)
		} catch (e) {
			console.error(TAG + ' success callback error: ' + JSON.stringify(e))
		}
	} else {
		try {
			options.fail?.(res)
		} catch (e) {
			console.error(TAG + ' fail callback error: ' + JSON.stringify(e))
		}
	}
	try {
		options.complete?.(res)
	} catch (e) {
		console.error(TAG + ' complete callback error: ' + JSON.stringify(e))
	}
}

/** 发送请求并回调调起结果（async helper，await 模式已验证） */
async function sendTransferReq(
	context: common.UIAbilityContext,
	wxApi: wxopensdk.WXApi,
	req: wxopensdk.OpenBusinessViewReq,
	options: RequestMerchantTransferOptions
): Promise<void> {
	try {
		const ok = await wxApi.sendReq(context, req)
		console.info(TAG + ' sendReq result: ' + ok)
		notifyResult(options, ok, ok ? 'requestMerchantTransfer:ok' : 'requestMerchantTransfer:fail')
	} catch (err) {
		console.error(TAG + ' sendReq failed: ' + JSON.stringify(err))
		notifyResult(options, false, 'requestMerchantTransfer:fail ' + JSON.stringify(err))
	}
}

/**
 * 调起微信确认收款页面。
 * success 仅代表页面拉起成功；用户确认结果通过 onMerchantTransferResult 接收
 * （或 getLastMerchantTransferResult 轮询读取）。
 */
export const requestMerchantTransfer: RequestMerchantTransfer = function (options: RequestMerchantTransferOptions): void {
	if (!ensureWxApi(options.appId)) {
		notifyResult(options, false, 'appId 不能为空')
		return
	}
	const wxApi = _wxApi!
	if (!wxApi.isWXAppInstalled()) {
		notifyResult(options, false, wechatUnavailableMsg())
		return
	}
	// query 组装对齐官方 android 实现：mchId/package/appId 必填，其余可选（均需 UrlEncode）
	let query = 'mchId=' + encodeURIComponent(options.mchId)
	query += '&package=' + encodeURIComponent(options.package)
	query += '&appId=' + encodeURIComponent(options.appId)
	if (options.openId != null && options.openId != '') {
		query += '&openId=' + encodeURIComponent(options.openId!)
	}
	if (options.subAppId != null && options.subAppId != '') {
		query += '&subAppId=' + encodeURIComponent(options.subAppId!)
	}
	if (options.subMchId != null && options.subMchId != '') {
		query += '&subMchId=' + encodeURIComponent(options.subMchId!)
	}
	const req = new wxopensdk.OpenBusinessViewReq()
	req.businessType = TRANSFER_BUSINESS_TYPE
	req.query = query
	console.info(TAG + ' requestMerchantTransfer launching, optional fields: ' + optionalFieldFlags(options))
	// 清理上次残留，等待微信回跳
	_lastResult = null
	const context = getContext() as common.UIAbilityContext
	sendTransferReq(context, wxApi, req, options)
}

export const onMerchantTransferResult: OnMerchantTransferResult = function (callback: MerchantTransferResultCallback): void {
	_pendingResultCallback = callback
}

export const offMerchantTransferResult: OffMerchantTransferResult = function (): void {
	_pendingResultCallback = null
}

export const getLastMerchantTransferResult: GetLastMerchantTransferResult = function (): MerchantTransferResult | null {
	return _lastResult
}

export const clearMerchantTransferResult: ClearMerchantTransferResult = function (): void {
	_lastResult = null
}

/** 日志用：仅输出 Want.uri 前缀，避免打印完整回调参数 */
function wantUriBrief(want: Want): string {
	const raw = want.uri
	const s = raw == null ? '' : raw + ''
	if (s == '') {
		return '(empty)'
	}
	return s.length > 32 ? s.substring(0, 32) + '...' : s
}

/**
 * Want 分发核心：交给微信 SDK，命中转账 resp 时返回 true。
 * WXApi 尚未建立（冷启动回跳、首次调起前回跳）则暂存 Want，等 appId 就绪后补投。
 */
function dispatchWant(want: Want, appId?: string): boolean {
	console.info(TAG + ' ability want received, uri=' + wantUriBrief(want))
	if (!ensureWxApi(appId ?? '')) {
		_pendingWant = want
		console.warn(TAG + ' want deferred: wxApi not ready, call setMerchantTransferAppId early')
		return false
	}
	const ok = _wxApi!.handleWant(want, _eventHandler)
	console.info(TAG + ' wx sdk handleWant consumed: ' + ok)
	if (ok) {
		_pendingWant = null
	}
	return ok
}

/** appId 就绪后补投暂存的 Want（冷启动回跳兜底） */
function flushPendingWant(): void {
	if (_pendingWant == null) {
		return
	}
	const pending = _pendingWant!
	_pendingWant = null
	console.info(TAG + ' flushing pending want, uri=' + wantUriBrief(pending))
	if (!ensureWxApi('')) {
		_pendingWant = pending
		return
	}
	if (!_wxApi!.handleWant(pending, _eventHandler)) {
		console.info(TAG + ' pending want not consumed by wx sdk')
	}
}

/**
 * 安装 EntryAbility 生命周期钩子，插件加载即接管微信回跳 Want，宿主无需修改原生代码。
 * onCreate 覆盖冷启动回跳，onNewWant 覆盖应用存活时的回跳。
 */
function installAbilityHooks(): void {
	if (_hooksInstalled) {
		return
	}
	_hooksInstalled = true
	try {
		UTSHarmony.onAppAbilityCreate((want: Want, launchParam: AbilityConstant.LaunchParam) => {
			dispatchWant(want)
		})
		UTSHarmony.onAppAbilityNewWant((want: Want, launchParam: AbilityConstant.LaunchParam) => {
			dispatchWant(want)
		})
		console.info(TAG + ' ability hooks installed')
	} catch (e) {
		// 低于 4.31 或其他异常：回退到宿主手工转发 handleWeChatWant
		_hooksInstalled = false
		console.error(TAG + ' install ability hooks failed, fallback to handleWeChatWant: ' + JSON.stringify(e))
	}
}

installAbilityHooks()

/**
 * 【可选】提前配置微信 appId。
 * 冷启动回跳场景下插件内部还没有 WXApi 实例，Want 无法分发；宿主在启动早期调一次本方法即可覆盖该场景。
 */
export function setMerchantTransferAppId(appId: string): void {
	if (!ensureWxApi(appId)) {
		console.warn(TAG + ' setMerchantTransferAppId: empty appId')
		return
	}
	flushPendingWant()
}

/**
 * 【可选兜底】在宿主 EntryAbility.onCreate / onNewWant 中手工转发微信回跳的 Want。
 * 仅适用于自行维护原生工程的场景；常规接入由插件内部 UTSHarmony 钩子自动完成，无需调用本方法。
 * @param want 微信回跳的 Want
 * @param appId 可选；首次调起前发生回跳时用它提前建立 WXApi
 */
export function handleWeChatWant(want: Want, appId?: string): boolean {
	return dispatchWant(want, appId)
}

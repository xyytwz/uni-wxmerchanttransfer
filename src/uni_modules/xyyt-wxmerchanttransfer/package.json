{
  "id": "xyyt-wxmerchanttransfer",
  "displayName": "微信商家转账确认收款（uni-app 鸿蒙 HarmonyOS NEXT）",
  "version": "1.0.0",
  "description": "鸿蒙（HarmonyOS NEXT）端微信商家转账用户确认收款：调起微信确认收款页面（requestMerchantTransfer），并回传用户确认结果（success/fail/cancel）。补位官方 uni-requestMerchantTransfer 缺失的鸿蒙实现，调起字段与官方 API 一致。因鸿蒙 UTS 插件无生命周期代理，需在宿主 EntryAbility 转发微信回跳 Want，文档含集成示例与 demo 工程。",
  "keywords": [
    "确认收款",
    "商家转账",
    "requestMerchantTransfer",
    "微信",
    "鸿蒙",
    "uni-app",
    "UTS"
  ],
  "repository": "https://github.com/xyytwz/xyyt-wxmerchanttransfer",
  "engines": {
    "HBuilderX": "^4.23"
  },
